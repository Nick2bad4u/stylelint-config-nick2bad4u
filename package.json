{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "stylelint-config-nick2bad4u",
    "version": "1.0.15",
    "private": false,
    "description": "Shared Stylelint config for Nick2bad4u projects.",
    "keywords": [
        "stylelint",
        "stylelint-config",
        "css",
        "scss",
        "linting"
    ],
    "homepage": "https://github.com/Nick2bad4u/stylelint-config-nick2bad4u#readme",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/stylelint-config-nick2bad4u/issues",
        "email": "20943337+Nick2bad4u@users.noreply.github.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/stylelint-config-nick2bad4u.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)",
    "contributors": [
        {
            "name": "Nick2bad4u",
            "email": "20943337+Nick2bad4u@users.noreply.github.com",
            "url": "https://github.com/Nick2bad4u"
        }
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/stylelint.config.d.ts",
            "import": "./dist/stylelint.config.js",
            "require": null
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/stylelint.config.js",
    "types": "./dist/stylelint.config.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "npm run clean:dist && tsc -p tsconfig.build.json",
        "changelog:generate": "git-cliff --config cliff.toml --output CHANGELOG.md",
        "changelog:preview": "git-cliff --config cliff.toml --unreleased",
        "changelog:release-notes": "git-cliff --config cliff.toml --current --strip all",
        "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "coverage": "vitest run --coverage",
        "lint": "cross-env NODE_OPTIONS=--max_old_space_size=8192 eslint . --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:all": "npm run lint && npm run typecheck && npm run test && npm run test:stylelint-config && npm run lint:prettier && npm run lint:package && npm run lint:yaml && npm run lint:secretlint",
        "lint:all:fix": "npm run lint:fix && npm run lint:prettier:fix && npm run lint:package:fix && npm run typecheck && npm run test && npm run test:stylelint-config && npm run lint:yaml:fix && npm run lint:secretlint",
        "lint:attw": "attw . --pack --profile esm-only --entrypoints \".\" \"./package.json\"",
        "lint:fix": "npm run lint -- --fix",
        "lint:package": "npm run lint:package-sort && npm run lint:package-json && npm run lint:package-check",
        "lint:package:fix": "sort-package-json package.json",
        "lint:package-check": "npm run package:check && npm run lint:publint && npm run lint:attw",
        "lint:package-fix": "npm run lint:package:fix",
        "lint:package-json": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:package-sort": "sort-package-json --check package.json",
        "lint:prettier": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --check",
        "lint:prettier:fix": "prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --write",
        "lint:publint": "publint",
        "lint:secretlint": "secretlint --secretlintrc .secretlintrc.cjs --secretlintignore .gitignore \"**/*\"",
        "lint:yaml": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache \"**/*.{yml,yaml}\"",
        "lint:yaml:fix": "npm run lint:yaml -- --fix",
        "package:check": "npm pack --dry-run",
        "release:check": "npm run release:verify",
        "release:verify": "npm run build && npm run lint:all && npm run lint:package-check",
        "sync:node-version": "node scripts/sync-node-version-files.mjs",
        "sync:peer-stylelint": "node scripts/sync-peer-stylelint-range.mjs",
        "pretest": "npm run build",
        "test": "vitest run",
        "test:coverage": "npm run coverage",
        "pretest:stylelint-config": "npm run build",
        "test:stylelint-config": "vitest run test/preset.test.ts",
        "typecheck": "npm run build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.eslint.json --noEmit && tsc -p tsconfig.js.json --noEmit && tsc -p tsconfig.vitest-typecheck.json --noEmit",
        "typecheck:all": "npm run typecheck",
        "types:update": "typesync",
        "update-deps": "npx ncu -i --install never && npm update --force && npm install --force && npm run sync:peer-stylelint && npm run sync:node-version",
        "verify": "npm run release:verify"
    },
    "overrides": {
        "fflate": "0.8.2"
    },
    "dependencies": {
        "@csstools/stylelint-formatter-github": "^2.0.0",
        "@double-great/stylelint-a11y": "^3.4.14",
        "@stylelint-types/stylelint-order": "^8.1.1",
        "@stylelint-types/stylelint-stylistic": "^5.1.0",
        "@stylistic/stylelint-plugin": "^5.2.0",
        "postcss-html": "^1.8.1",
        "postcss-scss": "^4.0.9",
        "postcss-styled-jsx": "^1.0.1",
        "postcss-styled-syntax": "^0.7.1",
        "postcss-syntax": "^0.36.2",
        "stylelint-checkstyle-formatter": "^0.1.2",
        "stylelint-codeframe-formatter": "^1.2.0",
        "stylelint-config-alphabetical-order": "^2.0.0",
        "stylelint-config-idiomatic-order": "^10.0.0",
        "stylelint-config-inspector": "^2.3.2",
        "stylelint-config-recess-order": "^7.7.0",
        "stylelint-config-recommended": "^18.0.0",
        "stylelint-config-sass-guidelines": "^13.0.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-config-tailwindcss": "^1.0.1",
        "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
        "stylelint-declaration-strict-value": "^1.11.1",
        "stylelint-find-new-rules": "^6.0.0",
        "stylelint-formatter-gitlab-code-quality-report": "^1.1.0",
        "stylelint-formatter-pretty": "^4.0.1",
        "stylelint-gamut": "^2.0.1",
        "stylelint-group-selectors": "^1.0.10",
        "stylelint-high-performance-animation": "^2.0.0",
        "stylelint-media-use-custom-media": "^4.1.0",
        "stylelint-no-browser-hacks": "^2.0.3",
        "stylelint-no-unsupported-browser-features": "^8.1.1",
        "stylelint-order": "^8.1.1",
        "stylelint-plugin-container-query-sanity": "^0.1.1",
        "stylelint-plugin-css-performance-budget": "^2.0.4",
        "stylelint-plugin-defensive-css": "^2.9.3",
        "stylelint-plugin-docusaurus": "^2.0.2",
        "stylelint-plugin-font": "^1.1.3",
        "stylelint-plugin-grid": "^1.0.2",
        "stylelint-plugin-use-baseline": "^1.4.2",
        "stylelint-prettier": "^5.0.3",
        "stylelint-scales": "^5.0.0",
        "stylelint-scss": "^7.1.1",
        "stylelint-use-nesting": "^6.0.2",
        "stylelint-value-no-unknown-custom-properties": "^6.1.1"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.3",
        "@types/node": "^25.9.1",
        "@vitest/coverage-v8": "^4.1.7",
        "cross-env": "^10.1.0",
        "eslint": "^10.4.1",
        "eslint-config-nick2bad4u": "^1.2.4",
        "git-cliff": "^2.13.1",
        "npm-package-json-lint": "^10.4.0",
        "picocolors": "^1.1.1",
        "prettier": "^3.8.3",
        "prettier-config-nick2bad4u": "^1.0.13",
        "publint": "^0.3.21",
        "secretlint": "^13.0.2",
        "secretlint-config-nick2bad4u": "^1.0.5",
        "sort-package-json": "^3.6.1",
        "stylelint": "^17.12.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.14",
        "vitest": "^4.1.7"
    },
    "peerDependencies": {
        "stylelint": "^17.9.1 || ^17.12.0"
    },
    "peerDependenciesMeta": {
        "stylelint": {
            "optional": false
        }
    },
    "packageManager": "npm@11.16.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.0.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=11.0.0",
            "onFail": "error"
        }
    },
    "publishConfig": {
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "readme": "README.md"
}
