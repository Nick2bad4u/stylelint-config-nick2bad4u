{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "stylelint-config-nick2bad4u",
    "version": "3.0.0",
    "private": false,
    "description": "Shared Stylelint config for Nick2bad4u projects.",
    "keywords": [
        "stylelint",
        "stylelint-config",
        "css",
        "scss",
        "linting"
    ],
    "homepage": "https://github.com/Nick2bad4u/stylelint-config-nick2bad4u#readme",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/stylelint-config-nick2bad4u/issues",
        "email": "20943337+Nick2bad4u@users.noreply.github.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/stylelint-config-nick2bad4u.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)",
    "contributors": [
        {
            "name": "Nick2bad4u",
            "email": "20943337+Nick2bad4u@users.noreply.github.com",
            "url": "https://github.com/Nick2bad4u"
        }
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/stylelint.config.d.ts",
            "import": "./dist/stylelint.config.js",
            "require": null
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/stylelint.config.js",
    "types": "./dist/stylelint.config.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "npm run clean:dist && npx tsc -p tsconfig.build.json",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/stylelint-config-nick2bad4u --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/stylelint-config-nick2bad4u --unreleased",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/stylelint-config-nick2bad4u --current",
        "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "coverage": "npx vitest run --coverage",
        "lint": "npx cross-env NODE_OPTIONS=--max_old_space_size=8192 npx eslint . --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:all": "npm run lint && npm run typecheck && npm run test && npm run lint:remark && npm run test:stylelint-config && npm run lint:prettier && npm run lint:package-manager-version && npm run lint:package && npm run lint:yaml && npm run lint:gitleaks && npm run lint:yamllint && npm run lint:secretlint",
        "lint:all:fix": "npm run lint:fix && npm run lint:remark:fix && npm run lint:prettier:fix && npm run sync:package-manager-version && npm run lint:package:fix && npm run typecheck && npm run test && npm run test:stylelint-config && npm run lint:yaml:fix && npm run lint:secretlint",
        "lint:attw": "npx attw . --pack --profile esm-only --entrypoints \".\" \"./package.json\"",
        "lint:fix": "npm run lint -- --fix",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:jscpd": "npx jscpd --config node_modules/jscpd-config-nick2bad4u/jscpd.json",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml .",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md",
        "lint:package": "npm run lint:package-sort && npm run lint:package-json && npm run lint:package-check",
        "lint:package:fix": "npx sort-package-json package.json",
        "lint:package-check": "npm run package:check && npm run lint:publint && npm run lint:attw",
        "lint:package-fix": "npm run lint:package:fix",
        "lint:package-json": "npx npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:package-manager-version": "npm run sync:package-manager-version -- --check",
        "lint:package-sort": "npx sort-package-json --check package.json",
        "lint:prettier": "npx prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --check",
        "lint:prettier:fix": "npx prettier . --log-level warn --cache --cache-location=.cache/.prettier-cache --cache-strategy=content --write",
        "lint:publint": "npx publint",
        "lint:remark": "npx remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "npx remark . --ignore-path .remarkignore --output",
        "lint:secretlint": "npx secretlint --secretlintrc .secretlintrc.cjs --secretlintignore .gitignore \"**/*\"",
        "lint:yaml": "npx eslint --cache --cache-strategy content --cache-location .cache/.eslintcache \"**/*.{yml,yaml}\"",
        "lint:yaml:fix": "npm run lint:yaml -- --fix",
        "lint:yamllint": "yamllint -c .yamllint .",
        "package:check": "npm pack --dry-run",
        "release:check": "npm run release:verify",
        "release:verify": "npm run build && npm run lint:all && npm run lint:package-check",
        "sync:node-version": "node scripts/sync-node-version-files.mjs",
        "sync:node-version:check": "node scripts/sync-node-version-files.mjs --check",
        "sync:package-manager-version": "node scripts/sync-package-manager-version.mjs",
        "sync:peer-stylelint": "node scripts/sync-peer-stylelint-range.mjs",
        "pretest": "npm run build",
        "test": "npx vitest run",
        "test:coverage": "npm run coverage",
        "pretest:stylelint-config": "npm run build",
        "test:stylelint-config": "npx vitest run test/preset.test.ts",
        "typecheck": "npm run build && npx tsc -p tsconfig.json --noEmit && npx tsc -p tsconfig.eslint.json --noEmit && npx tsc -p tsconfig.js.json --noEmit && npx tsc -p tsconfig.vitest-typecheck.json --noEmit",
        "typecheck:all": "npm run typecheck",
        "types:update": "npx typesync",
        "update-actions": "npx actions-up --yes --style sha",
        "update-all": "npm run update-actions && npm run update-deps",
        "update-deps": "npx ncu --configFileName .ncurc.json --configFilePath node_modules/ncu-config-nick2bad4u && npm run sync:package-manager-version && npm run sync:peer-stylelint && npm run sync:node-version && npx cross-env npm_config_allow_scripts= npm update --all",
        "verify": "npm run release:verify"
    },
    "dependencies": {
        "@double-great/stylelint-a11y": "^3.5.2",
        "@stylistic/stylelint-plugin": "^5.3.0",
        "postcss-html": "^2.0.0",
        "postcss-scss": "^4.0.9",
        "postcss-styled-jsx": "^1.0.1",
        "postcss-styled-syntax": "^0.7.2",
        "stylelint-config-recess-order": "^7.8.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-config-tailwindcss": "^1.0.1",
        "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
        "stylelint-declaration-strict-value": "^1.11.1",
        "stylelint-gamut": "^2.0.1",
        "stylelint-group-selectors": "^1.0.10",
        "stylelint-high-performance-animation": "^2.0.0",
        "stylelint-media-use-custom-media": "^4.1.0",
        "stylelint-no-browser-hacks": "^2.0.3",
        "stylelint-no-unsupported-browser-features": "^8.1.1",
        "stylelint-order": "^8.1.1",
        "stylelint-plugin-container-query-sanity": "^0.1.4",
        "stylelint-plugin-css-performance-budget": "^2.0.7",
        "stylelint-plugin-defensive-css": "^2.9.6",
        "stylelint-plugin-docusaurus": "^2.0.5",
        "stylelint-plugin-file-progress": "^1.0.0",
        "stylelint-plugin-font": "^1.1.7",
        "stylelint-plugin-grid": "^1.0.6",
        "stylelint-plugin-use-baseline": "^1.4.5",
        "stylelint-prettier": "^5.0.3",
        "stylelint-scales": "^5.0.0",
        "stylelint-scss": "^7.2.0",
        "stylelint-use-nesting": "^6.0.2",
        "stylelint-value-no-unknown-custom-properties": "^6.1.1"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@microsoft/tsdoc-config": "^0.18.1",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.1",
        "eslint-config-nick2bad4u": "^14.1.0",
        "git-cliff": "^2.13.1",
        "gitcliff-config-nick2bad4u": "^1.5.0",
        "gitleaks-config-nick2bad4u": "^1.0.5",
        "jscpd": "^5.0.16",
        "jscpd-config-nick2bad4u": "^1.1.1",
        "lychee-config-nick2bad4u": "^3.0.0",
        "ncu-config-nick2bad4u": "^0.2.1",
        "npm-check-updates": "^23.0.2",
        "npm-package-json-lint": "^11.0.0",
        "npm-package-json-lint-config-nick2bad4u": "^1.0.4",
        "picocolors": "^1.1.1",
        "prettier": "^3.9.6",
        "prettier-config-nick2bad4u": "^2.0.2",
        "publint": "^0.3.24",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.1.3",
        "secretlint": "^13.0.4",
        "secretlint-config-nick2bad4u": "^1.1.2",
        "sort-package-json": "^4.0.0",
        "stylelint": "^17.14.1",
        "stylelint-config-inspector": "^2.3.5",
        "tsdoc-config-nick2bad4u": "^1.0.6",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "yamllint-config-nick2bad4u": "^1.1.1"
    },
    "peerDependencies": {
        "stylelint": "^17.14.0"
    },
    "peerDependenciesMeta": {
        "stylelint": {
            "optional": false
        }
    },
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">=22.12.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": "12",
            "onFail": "error"
        }
    },
    "publishConfig": {
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "allowScripts": {
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true,
        "core-js": false,
        "esbuild@0.28.2": true
    },
    "readme": "README.md"
}
